{
  "name": "elchi-marketplace",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001",
    "start:prod": "next start -p 3002",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "check": "npm run api:check && npm run typecheck && npm run lint && npm test && npm run build",
    "test": "node --test tests/*.test.mjs",
    "api:generate": "node scripts/generate-api.mjs",
    "api:check": "node scripts/generate-api.mjs --check",
    "test:api:live": "node scripts/smoke-api.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "next": "15.5.25",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "ajv": "^8.20.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.23",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.15.0"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "postcss": "8.5.23"
  }
}
