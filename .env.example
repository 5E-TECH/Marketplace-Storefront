# Server-side API sozlamalari. Backend 3000 da bo‘lsa frontendni 3001 da oching.
API_BASE_URL=https://api.elchimarket.uz/api/v1
NEXT_PUBLIC_API_URL=https://api.elchimarket.uz/api/v1
API_TIMEOUT_MS=10000
USE_MOCK_DATA=false
NEXT_PUBLIC_SITE_URL=http://localhost:3001
SITE_URL=http://localhost:3001
# Production reverse proxy: ildiz domen storefront'ga, admin subdomen kabinetga.
STOREFRONT_DOMAIN=elchimarket.uz
ADMIN_DOMAIN=admin.elchimarket.uz
