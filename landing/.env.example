# Sotuvchi sahifasi (landing/). Nusxa: cp .env.example .env.local
# Sukut — mock (backendsiz). Backend bilan: MOCK_API=false va API_BASE_URL (BE-11 marketplace `dev` da).
MOCK_API=true
# Lokal backend (prod manzili lokalda ishlatilmaydi). MOCK_API=false bo‘lganda kerak.
API_BASE_URL=http://localhost:3000/api/v1
API_TIMEOUT_MS=10000
# Aloqa telefoni — EQ-05 javobidan keyin. Bo‘sh bo‘lsa telefon bloki sahifada chiqmaydi. Build vaqtida o‘qiladi.
NEXT_PUBLIC_SUPPORT_PHONE=
