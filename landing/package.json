{
  "name": "elchi-landing",
  "version": "0.1.0",
  "private": true,
  "description": "Sotuvchi sahifasi (SF-01): do‘kon saytidan alohida, provayderlarsiz yengil Next.js ilovasi.",
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start -p 3003",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build && npm run test:smoke"
  },
  "dependencies": {
    "next": "15.5.25",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "eslint": "^9.17.0",
    "eslint-config-next": "15.5.23",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=22.15.0"
  }
}
